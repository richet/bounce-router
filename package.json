{
  "name": "bouncerouter",
  "version": "0.3.0",
  "description": "One terminal. Your local coding agent subscriptions.",
  "type": "module",
  "bin": {
    "bounce": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test \"test/**/*.test.js\"",
    "baseline": "node scripts/baseline.mjs",
    "check": "find src -name '*.js' -print0 | xargs -0 -n1 node --check"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richet/bounce-router.git"
  },
  "files": [
    "src/",
    "skills/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "ink": "7.1.1",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "19.2.4",
    "slice-ansi": "^7.1.2",
    "string-width": "^7.2.0",
    "strip-ansi": "^7.2.0",
    "wrap-ansi": "^9.0.2"
  }
}
